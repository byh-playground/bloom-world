{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byh-playground.github.io/bloom-world/playground/bloom-game.schema.json",
  "title": "BLOOM PLAYGROUND 게임 매니페스트",
  "description": "게임 저장소 루트의 bloom-game.json 규격. 설명은 docs 참고: playground/MANIFEST.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "en", "genre", "tags", "desc", "points"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 20 },
    "en": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9 ]{0,29}$" },
    "genre": { "enum": ["strategy", "action", "sandbox", "simulation"] },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 16 }
    },
    "desc": { "type": "string", "minLength": 1, "maxLength": 80 },
    "points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "showcase": { "type": "string", "pattern": "^https://\\S+$", "maxLength": 200 },
    "stable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "nightly": { "type": "string", "pattern": "^nightly-\\d{8}T\\d{6}Z-[0-9a-f]{12}$" }
  }
}
